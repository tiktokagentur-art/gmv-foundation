FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000
WORKDIR /app
COPY requirements.txt requirements-api.txt /app/
RUN python -m pip install --no-cache-dir -r requirements-api.txt
COPY worker.py api.py live_runtime.py /app/
COPY examples /app/examples
USER 65532:65532

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT', '8000'), timeout=2)"]

# The HTTP process stays up. Activation remains fail-closed until verified.
CMD ["sh", "-c", "exec uvicorn api:app --host 0.0.0.0 --port \"$PORT\" --no-access-log"]
